# ============================================================
# SnapMap — Modèle de variables d'environnement (COMMITÉ).
# Copier en .env et renseigner ses propres clés :  cp .env.example .env
# ============================================================

# --- Carte : Leaflet + tuiles OpenStreetMap (open-source, AUCUNE clé requise) ---
# Reverse geocoding (Défi 2) via Nominatim/OSM — sans clé non plus.

# --- Stripe (front) : clé PUBLIQUE ---
STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE
STRIPE_API_URL=http://localhost:4000

# --- Backend Express (Partie 3) : clé SECRÈTE ---
# ⚠️ JAMAIS côté front. Lue par le serveur Stripe (stripe-backend) uniquement.
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE
